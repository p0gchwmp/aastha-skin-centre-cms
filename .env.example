DJANGO_SETTINGS_MODULE=aastha_cms.settings.production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database
ALLOWED_HOSTS=.onrender.com,aasthaskincentre.in,www.aasthaskincentre.in
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://aasthaskincentre.in,https://www.aasthaskincentre.in
WAGTAILADMIN_BASE_URL=https://example.onrender.com
SITE_HOSTNAME=example.onrender.com
MEDIA_ROOT=/var/data/media
DJANGO_SUPERUSER_USERNAME=site-admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-unique-long-password
